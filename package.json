{
  "name": "fivem-cement-map",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive GTA V FiveM Map tracker for cement gathering, custom landmarks, cooldown timers, and coordinates.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "typecheck": "wrangler types && tsc -b --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "wrangler types && tsc -b && tsc --noEmit -p tsconfig.worker.json && vite build",
    "lint": "oxlint src worker tests",
    "test": "node --test tests/*.test.ts",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.39.0",
    "mqtt": "^5.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.160.0"
  }
}
